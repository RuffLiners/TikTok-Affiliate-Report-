# ============================================================
# TikTok Affiliate Report Kit — Environment Variables
# Vercel: add these in Project → Settings → Environment Variables
# Local:  copy this file to dashboard/.env.local and fill in values
# Never commit real values to GitHub.
# ============================================================

# --- Your brand (shown in the header, login page, tab title, prompts) ---
NEXT_PUBLIC_BRAND_NAME=Your Brand Name

# --- Supabase (Supabase project → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Auth (make these up — use a strong random string) ---
AUTH_SECRET=some-long-random-string-at-least-32-chars
DASHBOARD_PASSWORD=your-dashboard-login-password

# --- Claude / Anthropic (https://console.anthropic.com) ---
# Required for the automated "+ New Report" button and AI analysis.
ANTHROPIC_API_KEY=sk-ant-...

# --- Euka (your Euka account settings) ---
EUKA_STORE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EUKA_MCP_URL=https://app.euka.ai/api/mcp
EUKA_BEARER_TOKEN=Bearer eyJ...

# --- Optional model overrides (defaults are fine for most users) ---
# EXTRACTION_MODEL=claude-sonnet-4-6
# ANALYSIS_MODEL=claude-sonnet-4-6
