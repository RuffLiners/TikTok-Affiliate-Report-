{
  "name": "ruff-liners-report-pipeline",
  "private": true,
  "type": "module",
  "scripts": {
    "probe": "tsx src/probe.ts",
    "typecheck": "tsc --noEmit",
    "scorecard": "tsx src/run.ts",
    "snapshot": "tsx src/snapshot.ts",
    "watchdog": "tsx src/watchdog.ts",
    "test": "tsx --test src/pull.test.ts src/plan.test.ts src/drift.test.ts src/contests.test.ts src/weekly/weekly.test.ts",
    "weekly-report": "tsx src/weekly-report.ts",
    "weekly-status": "tsx src/weekly-status.ts",
