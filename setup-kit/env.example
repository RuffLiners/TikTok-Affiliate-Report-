# ============================================================
# TikTok Affiliate Dashboard — Environment Variables
# Copy these into your Vercel project settings.
# Never commit real values to GitHub.
# ============================================================

# --- Supabase (get from your Supabase project → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Auth (make these up — use a strong random string) ---
AUTH_SECRET=some-long-random-string-at-least-32-chars
DASHBOARD_PASSWORD=your-dashboard-login-password

# --- Claude / Anthropic (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Euka (get from your Euka account settings) ---
EUKA_STORE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EUKA_MCP_URL=https://app.euka.ai/api/mcp
EUKA_BEARER_TOKEN=Bearer eyJ...
